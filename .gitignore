# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
build/
dist/

# data and model artefacts (downloaded on demand, never committed)
data/cifar*/
data/CIFAR*/
**/data/cifar-10-batches-py/
**/data/cifar-100-python/
**/data/CIFAR-10-C/
